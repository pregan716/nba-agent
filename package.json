{
  "name": "nba-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "pin": "tsx scripts/pin.ts",
    "coverage": "tsx scripts/coverage.ts",
    "verify:live": "tsx scripts/verify.ts",
    "format": "prettier --write src scripts test/*.ts package.json tsconfig.json",
    "format:check": "prettier --check src scripts test/*.ts package.json tsconfig.json",
    "audit": "tsx scripts/audit.ts",
    "questions": "tsx scripts/questions.ts",
    "runner:fixture": "tsx scripts/runner-fixture.ts",
    "session:verify": "tsx scripts/session-verify.ts",
    "sandbox:build": "tsx scripts/sandbox-build.ts",
    "test:sandbox": "tsx scripts/sandbox-test.ts",
    "launch": "tsx scripts/run.ts",
    "probe": "tsx scripts/contamination-probe.ts",
    "report": "tsx scripts/report.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@js-temporal/polyfill": "^0.5.1",
    "hyparquet": "^1.31.5",
    "hyparquet-compressors": "^1.1.2",
    "stemmer": "^2.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
