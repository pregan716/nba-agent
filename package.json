{
  "name": "nba-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "pin": "tsx scripts/pin.ts",
    "coverage": "tsx scripts/coverage.ts",
    "verify:live": "tsx scripts/verify.ts",
    "format": "prettier --write src scripts test/*.ts package.json tsconfig.json",
    "format:check": "prettier --check src scripts test/*.ts package.json tsconfig.json",
    "audit": "tsx scripts/audit.ts",
    "runner:fixture": "tsx scripts/runner-fixture.ts",
    "session:verify": "tsx scripts/session-verify.ts",
    "sandbox:build": "tsx scripts/sandbox-build.ts",
    "test:sandbox": "tsx scripts/sandbox-test.ts",
    "probe": "tsx scripts/contamination-probe.ts",
    "projection": "tsx scripts/reference-projection.ts",
    "forecast:run": "tsx scripts/forecast-run.ts",
    "forecast:capture": "tsx scripts/forecast-capture.ts",
    "forecast:capture-check": "tsx scripts/forecast-capture-check.ts",
    "forecast:evaluate": "tsx scripts/forecast-evaluate.ts",
    "projection:build": "tsx scripts/projection-build.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@js-temporal/polyfill": "^0.5.1",
    "hyparquet": "^1.31.5",
    "hyparquet-compressors": "^1.1.2",
    "stemmer": "^2.0.1",
    "typebox": "1.3.27",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
