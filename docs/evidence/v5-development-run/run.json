  "hypotheses": [
    {
      "name": "lineup-starters",
      "closed": 0,
      "description": "Announced starting lineups + roster inactive flag + role-shifted minutes + redistribution + mild online quantile calibration (code only). In-sandbox backtest on ~150 earlier team-games: ratio ~0.94 avg (0.963/0.949/0.914). Expect full eval ratio 0.93-0.97."
    },
    {
      "name": "gbm-minutes",
      "closed": 0,
      "description": "Quantile GBM (league-wide, fitted in-loop on previous season) blended with the lineup-adjusted reference; blend weight chosen online per team from its own earlier games among {0,.25,.5} (default .25 until 10 games). Backtest honest nested ratios .959/.927/.910 vs base .963/.949/.914 (738/764/760). Early season (first ~12 games, EARLYBT): cur .852/.856/.834 vs ref; GBM without ramp better than ramp5 (.870/.851/.862) -> ramp off. Previous-season feature imputation for players with no current-season games slightly hurt (.853/.867/.843) -> off. Expect full ratio ~0.962-0.968 vs prior full 0.974."
    },
    {
      "name": "pred-lineup",
      "closed": 1,
      "description": "Rejected (test 345699cf). With announced lineups hidden in backtest: nolu .981/.979/.942 vs nolu_pred 1.102/1.053/.967 (738/764/760); without role shift still worse (1.048/1.006/.946). Predicting last game's starters with p_start .85 hurts badly. Code kept behind use_pred_lineup=False."
    },
    {
      "name": "absence-return",
      "closed": 0,
      "description": "Players returning after missing team games play fewer minutes than their recent played-minutes average. Fix: scale base minutes range by ratio table (role x gap bucket) fitted in-loop on previous season, before GBM blend (abs_w=1). Test 90c51b8a/2827cd55 backtest (738/764/760): with abs .9579/.9243/.9054 vs without .9576/.9278/.9073 -> ~0.2% gain, small but consistent on 2 of 3 teams. Adopted in draft (abs_w=1.0); not yet in a full run."
    },
    {
      "name": "spread-bench",
      "closed": 1,
      "description": "Rejected (test 2827cd55). Slope fitted on 2024-25 with point-diff proxy is small (b=0.034/pt of |margin|). Backtest (proxy |margin| for history games): spr10 worse than g25 on all 3 teams (+0.17%/+0.25%/+0.21%), uncertain-bench Brier unchanged. Live |spread| untested (no historical spreads in sandbox). Code kept, spr_w=0."
    },
    {
      "name": "injury-listed",
      "closed": 1,
      "description": "Neutral (test 8ee7f35f). League-wide in-loop table confirms effect (starters listed Available/Probable/Questionable, no absence: ratio 0.945, n=373; bench ~1.0), but backtest lst on vs off: 738 +0.1% worse, 764/760 -0.05% better -> off (lst_w=0). Code kept (gbm.injury_latest/listed_table, model.listed_adjust). Sandbox injury tables hold current season only (no 2024-25)."
    },
    {
      "name": "team-total",
      "closed": 0,
      "description": "Full run 4abbd0ba (fbfb2fbe + abs_w=1 + norm_w=1): ratio vs ref 0.972 [0.949,0.996]; paired vs fbfb2fbe 0.99993 [0.994,1.006] -> no measurable gain in the full eval. Backtest gain (~0.2-0.5%) did not appear. Not adopted for nomination."
    }
